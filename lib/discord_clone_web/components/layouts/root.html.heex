<!DOCTYPE html>
<% call_capabilities = DiscordClone.Calls.browser_media_capabilities(assigns[:current_scope]) %>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      :if={assigns[:current_scope] && assigns[:current_scope].user}
      id="call-signaling-bootstrap"
      name="call-signaling"
      content="authenticated"
      data-call-devices={call_capabilities.device_adapter}
      data-call-video-available={to_string(call_capabilities.video_available?)}
    />
    <.live_title default="Communication Platform" suffix="">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));

        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body class="min-h-screen bg-base-100">
    <div id="direct-call-page-content">{@inner_content}</div>
    <span
      :if={assigns[:current_scope] && assigns[:current_scope].user}
      id="direct-call-focus-fallback"
      tabindex="-1"
      class="sr-only"
    >
      Direct Call controls closed
    </span>
    <div
      :if={assigns[:current_scope] && assigns[:current_scope].user}
      id="direct-call-incoming-backdrop"
      hidden
      class={[
        "fixed inset-0 z-50 flex items-center justify-center bg-base-300/75 p-4",
        "backdrop-blur-sm"
      ]}
    >
      <section
        id="direct-call-incoming-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="direct-call-incoming-title"
        aria-describedby="direct-call-incoming-caller direct-call-incoming-intent direct-call-incoming-status"
        class={[
          "w-full max-w-sm rounded-3xl bg-base-200 p-6 text-base-content",
          "shadow-[0_28px_80px_rgb(0_0_0_/_0.5)] ring-1 ring-primary/25"
        ]}
      >
        <div class="flex items-start gap-4">
          <span class={[
            "flex size-12 shrink-0 items-center justify-center rounded-2xl bg-primary/15",
            "text-primary ring-1 ring-primary/25"
          ]}>
            <.icon name="hero-phone-arrow-down-left" class="size-5" />
          </span>
          <div class="min-w-0 flex-1">
            <h2
              id="direct-call-incoming-title"
              tabindex="-1"
              class="text-lg font-black tracking-tight focus-visible:outline-none"
            >
              Incoming call
            </h2>
            <p id="direct-call-incoming-caller" class="mt-1 truncate text-sm font-bold"></p>
            <p id="direct-call-incoming-intent" class="mt-1 text-xs text-base-content/60">
              Audio invitation
            </p>
          </div>
        </div>
        <p
          id="direct-call-incoming-status"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          class="mt-5 rounded-2xl bg-base-300/55 px-3.5 py-3 text-sm leading-5 text-base-content/75"
        >
        </p>
        <.call_preview id="direct-call-incoming-preview" />
        <div class="mt-5 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
          <button
            id="direct-call-incoming-cancel-preparation"
            type="button"
            data-call-action="cancel"
            aria-label="Cancel device preparation"
            hidden
            class={[
              "inline-flex h-11 items-center justify-center rounded-2xl px-4",
              "text-sm font-bold text-base-content ring-1 ring-base-content/20 transition",
              "hover:bg-base-content/10 focus-visible:outline-none focus-visible:ring-2",
              "focus-visible:ring-primary"
            ]}
          >
            Cancel preparation
          </button>
          <button
            id="direct-call-incoming-decline"
            type="button"
            data-call-action="decline"
            class={[
              "inline-flex h-11 items-center justify-center rounded-2xl px-4",
              "text-sm font-bold text-error ring-1 ring-error/30 transition",
              "hover:bg-error/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-error"
            ]}
          >
            Decline
          </button>
          <button
            id="direct-call-incoming-accept-audio"
            type="button"
            data-call-action="accept-audio"
            class={[
              "inline-flex h-11 items-center justify-center gap-2 rounded-2xl bg-success px-4",
              "text-sm font-bold text-success-content shadow-sm transition hover:bg-success/90",
              "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-success"
            ]}
          >
            <.icon name="hero-phone" class="size-4" /> Accept audio
          </button>
          <button
            id="direct-call-incoming-answer-without-video"
            type="button"
            data-call-action="answer-without-video"
            hidden
            class={[
              "inline-flex h-11 items-center justify-center gap-2 rounded-2xl px-4",
              "text-sm font-bold text-base-content ring-1 ring-base-content/20 transition",
              "hover:bg-base-content/10 focus-visible:outline-none focus-visible:ring-2",
              "focus-visible:ring-primary"
            ]}
          >
            <.icon name="hero-phone" class="size-4" /> Answer without video
          </button>
          <p id="direct-call-video-unavailable-reason" class="text-xs text-base-content/60" hidden>
            Video calling is unavailable. You can answer without video.
          </p>
          <button
            id="direct-call-incoming-accept-video"
            type="button"
            data-call-action="accept-video"
            aria-describedby={
              if(!call_capabilities.video_available?,
                do: "direct-call-video-unavailable-reason"
              )
            }
            hidden
            class={[
              "inline-flex h-11 items-center justify-center gap-2 rounded-2xl bg-success px-4",
              "text-sm font-bold text-success-content shadow-sm transition hover:bg-success/90",
              "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-success"
            ]}
          >
            <.icon name="hero-video-camera" class="size-4" /> Accept video
          </button>
        </div>
      </section>
    </div>
    <div :if={assigns[:current_scope] && assigns[:current_scope].user} id="direct-call-dock-home">
    </div>
    <section
      :if={assigns[:current_scope] && assigns[:current_scope].user}
      id="direct-call-dock"
      hidden
      data-call-dock-state="idle"
      aria-label="Direct Call"
      class={[
        "fixed right-4 bottom-4 z-40 w-[min(22rem,calc(100vw-2rem))]",
        "rounded-2xl bg-base-200 p-3.5 text-base-content",
        "shadow-[0_18px_40px_rgb(0_0_0_/_0.32)] ring-1 ring-primary/20"
      ]}
    >
      <div class="flex items-start gap-3">
        <span class={[
          "flex size-10 shrink-0 items-center justify-center rounded-2xl bg-primary/15",
          "text-primary ring-1 ring-primary/20"
        ]}>
          <.icon name="hero-phone" class="size-4" />
        </span>
        <div class="min-w-0 flex-1">
          <p
            id="direct-call-dock-title"
            tabindex="-1"
            class="text-[0.625rem] font-bold uppercase tracking-[0.14em] text-base-content/45"
          >
            Voice call
          </p>
          <p id="direct-call-dock-peer" class="mt-0.5 truncate text-sm font-bold"></p>
          <p
            id="direct-call-dock-status"
            role="status"
            aria-live="polite"
            aria-atomic="true"
            class="mt-1 text-xs font-medium leading-5 text-base-content/60"
          >
          </p>
        </div>
      </div>
      <div id="direct-call-participants" data-participants-active="false" class="mt-3">
        <figure
          id="direct-call-remote-video-region"
          hidden
          aria-labelledby="direct-call-remote-video-name"
        >
          <div class="call-participant-picture">
            <video
              id="direct-call-remote-video"
              muted
              playsinline
              autoplay
              aria-label="Other person's camera"
              aria-describedby="direct-call-remote-video-status"
              class="absolute inset-0 size-full object-contain"
            >
            </video>
            <div id="direct-call-remote-video-placeholder" class="call-participant-placeholder">
              <span
                id="direct-call-remote-video-avatar"
                class="call-participant-avatar"
                aria-hidden="true"
              >
                <.icon name="hero-user" class="size-6" />
              </span>
              <.icon name="hero-video-camera-slash" class="size-4" />
            </div>
          </div>
          <figcaption class="mt-2 min-w-0">
            <p id="direct-call-remote-video-name" class="truncate text-sm font-semibold">
              Friend
            </p>
            <p
              id="direct-call-remote-video-status"
              role="status"
              aria-live="polite"
              aria-atomic="true"
              class="call-participant-status"
            >
              Camera off
            </p>
          </figcaption>
          <button
            id="direct-call-remote-video-retry"
            type="button"
            data-call-action="retry-video"
            aria-controls="direct-call-remote-video"
            hidden
            class={[
              "mt-2 inline-flex min-h-9 items-center justify-center rounded-xl px-3",
              "text-xs font-semibold text-base-content ring-1 ring-base-content/30",
              "hover:bg-base-content/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
            ]}
          >
            Play video
          </button>
        </figure>
        <.call_preview id="direct-call-local-preview" participant />
      </div>
      <p
        id="direct-call-dock-media-state"
        hidden
        role="status"
        aria-live="polite"
        aria-atomic="true"
        class="mt-2 text-xs leading-5 text-base-content/60"
      >
      </p>
      <p
        id="direct-call-self-camera-status"
        hidden
        aria-live="off"
        class="mt-2 text-xs leading-5 text-base-content"
      >
      </p>
      <.link
        id="direct-call-dock-return"
        navigate={~p"/direct-messages"}
        hidden
        class={[
          "inline-flex min-h-9 items-center gap-2 rounded-xl px-3 text-xs font-semibold",
          "text-base-content ring-1 ring-base-content/25 hover:bg-base-content/10",
          "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        ]}
      >
        <.icon name="hero-arrow-uturn-left" class="size-4" /> Return to conversation
      </.link>
      <div id="direct-call-dock-controls" class="mt-3 flex flex-wrap gap-1.5">
        <button
          id="direct-call-dock-cancel"
          type="button"
          data-call-action="cancel"
          hidden
          class={[
            "inline-flex h-9 min-w-20 items-center justify-center rounded-xl px-3",
            "text-xs font-semibold text-error ring-1 ring-error/25",
            "transition hover:bg-error/10 focus-visible:outline-none",
            "focus-visible:ring-2 focus-visible:ring-error"
          ]}
        >
          Cancel
        </button>
        <button
          id="direct-call-dock-enable-microphone"
          type="button"
          data-call-action="enable-microphone"
          hidden
          class={[
            "inline-flex h-9 items-center justify-center gap-2 rounded-xl bg-primary px-3",
            "text-xs font-semibold text-primary-content shadow-sm transition hover:bg-primary/90",
            "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          ]}
        >
          <.icon name="hero-microphone" class="size-4" /> Enable microphone
        </button>
        <button
          id="direct-call-dock-camera"
          type="button"
          data-call-action="toggle-camera"
          aria-label="Turn camera on"
          data-active="false"
          hidden
          class={[
            "inline-flex h-9 min-w-20 items-center justify-center rounded-xl px-3",
            "text-xs font-semibold ring-1 ring-base-content/20 transition hover:bg-base-content/10",
            "data-[active=true]:bg-primary/15 data-[active=true]:text-primary",
            "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          ]}
        >
          Camera on
        </button>
        <span
          id="direct-call-camera-unavailable-reason"
          hidden
          class="text-xs text-base-content/60"
        >
          Camera is unavailable. Audio calls are ready.
        </span>
        <button
          id="direct-call-dock-size"
          type="button"
          data-call-action="toggle-size"
          aria-controls="direct-call-participants"
          aria-expanded="false"
          hidden
          class={[
            "inline-flex min-h-9 items-center justify-center rounded-xl px-3",
            "text-xs font-semibold ring-1 ring-base-content/20 transition hover:bg-base-content/10",
            "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          ]}
        >
          Expand
        </button>
        <button
          id="direct-call-dock-preview"
          type="button"
          data-call-action="toggle-preview"
          aria-controls="direct-call-local-preview-region"
          hidden
          class={[
            "inline-flex min-h-9 items-center justify-center rounded-xl px-3",
            "text-xs font-semibold ring-1 ring-base-content/20 transition hover:bg-base-content/10",
            "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          ]}
        >
          Hide Self-preview
        </button>
        <button
          id="direct-call-dock-mute"
          type="button"
          data-call-action="toggle-mute"
          aria-label="Mute microphone"
          data-active="false"
          hidden
          class={[
            "inline-flex h-9 min-w-20 items-center justify-center rounded-xl px-3",
            "text-xs font-semibold ring-1 ring-base-content/20 transition hover:bg-base-content/10",
            "data-[active=true]:bg-primary/15 data-[active=true]:text-primary",
            "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          ]}
        >
          Mute
        </button>
        <button
          id="direct-call-dock-deafen"
          type="button"
          data-call-action="toggle-deafen"
          aria-label="Deafen audio"
          data-active="false"
          hidden
          class={[
            "inline-flex h-9 min-w-20 items-center justify-center rounded-xl px-3",
            "text-xs font-semibold ring-1 ring-base-content/20 transition hover:bg-base-content/10",
            "data-[active=true]:bg-primary/15 data-[active=true]:text-primary",
            "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          ]}
        >
          Deafen
        </button>
        <button
          id="direct-call-dock-enable-audio"
          type="button"
          data-call-action="enable-audio"
          aria-label="Play call audio"
          hidden
          class={[
            "inline-flex h-9 min-w-20 items-center justify-center rounded-xl bg-primary px-3",
            "text-xs font-semibold text-primary-content shadow-sm transition hover:bg-primary/90",
            "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          ]}
        >
          Play audio
        </button>
        <button
          id="direct-call-dock-leave"
          type="button"
          data-call-action="leave"
          hidden
          class={[
            "inline-flex h-9 min-w-20 items-center justify-center rounded-xl px-3",
            "text-xs font-semibold text-error ring-1 ring-error/25",
            "transition hover:bg-error/10 focus-visible:outline-none",
            "focus-visible:ring-2 focus-visible:ring-error"
          ]}
        >
          Leave
        </button>
        <button
          id="direct-call-dock-retry"
          type="button"
          data-call-action="retry"
          hidden
          class={[
            "inline-flex h-9 min-w-20 items-center justify-center rounded-xl bg-primary px-3",
            "text-xs font-semibold text-primary-content shadow-sm",
            "transition hover:bg-primary/90 focus-visible:outline-none",
            "focus-visible:ring-2 focus-visible:ring-primary"
          ]}
        >
          Retry
        </button>
        <button
          id="direct-call-dock-start-voice-instead"
          type="button"
          data-call-action="fallback-audio"
          hidden
          class={[
            "inline-flex h-9 min-w-20 items-center justify-center rounded-xl px-3",
            "text-xs font-semibold text-base-content/80 ring-1 ring-base-300/80",
            "transition hover:bg-base-100 hover:text-base-content focus-visible:outline-none",
            "focus-visible:ring-2 focus-visible:ring-primary"
          ]}
        >
          Start audio call instead
        </button>
        <button
          id="direct-call-dock-dismiss"
          type="button"
          data-call-action="dismiss"
          hidden
          class={[
            "inline-flex h-9 min-w-20 items-center justify-center rounded-xl px-3",
            "text-xs font-semibold text-base-content/70 ring-1 ring-base-300/80",
            "transition hover:bg-base-100 hover:text-base-content focus-visible:outline-none",
            "focus-visible:ring-2 focus-visible:ring-primary"
          ]}
        >
          Dismiss
        </button>
      </div>
    </section>
  </body>
</html>
