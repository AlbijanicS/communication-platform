<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main id="invite-preview-page" class="min-h-screen bg-base-200 px-4 py-12 sm:px-6 lg:px-8">
    <section class="mx-auto flex min-h-[calc(100vh-6rem)] max-w-md items-center">
      <div class="w-full rounded border border-base-300 bg-base-100 p-6 text-center shadow-sm">
        <div class="mx-auto flex size-12 items-center justify-center rounded bg-error/10 text-error">
          <.icon name="hero-x-mark" class="size-6" />
        </div>

        <p class="mt-6 text-xs font-semibold uppercase tracking-wide text-error">
          Invite unavailable
        </p>
        <h1 id="invite-preview-title" class="mt-2 text-2xl font-semibold tracking-tight">
          {@title}
        </h1>
        <p id="invite-preview-failure" class="mt-3 text-sm text-base-content/70">
          {@body}
        </p>
      </div>
    </section>
  </main>
</Layouts.app>
