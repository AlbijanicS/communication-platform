# Optional production configuration. Local development does not need this file.
# Phoenix reads the process environment; this file is not loaded automatically.
# Replace every placeholder before exporting these values for a deployment.
PHX_SERVER=true
PHX_HOST=app.example.com
PORT=4000
DATABASE_URL=ecto://USER:PASSWORD@localhost/DATABASE
SECRET_KEY_BASE=REPLACE_WITH_OUTPUT_OF_mix_phx_gen_secret
RELEASE_DISTRIBUTION=none
VOICE_ICE_MODE=standard
VOICE_STUN_URLS=stun:stun.cloudflare.com:3478
VOICE_INTERNAL_IPV4=REPLACE_WITH_SERVER_PRIVATE_IPV4
VOICE_EXTERNAL_IPV4=REPLACE_WITH_SERVER_PUBLIC_IPV4
VOICE_TURN_CREDENTIAL_TTL_SECONDS=3600
CLOUDFLARE_TURN_KEY_ID=REPLACE_WITH_YOUR_KEY_ID
CLOUDFLARE_TURN_API_TOKEN=REPLACE_WITH_YOUR_API_TOKEN
